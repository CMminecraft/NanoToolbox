<UserControl x:Class="Toolbox.QRCodeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题（图标 + 工具名） -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="40" Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="二维码生成" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="文本或链接生成 QR 码图片" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 输入区 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="16,14">
            <StackPanel>
                <TextBlock Text="内容（文本或链接，支持中文/UTF-8）" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="ContentInput" Height="74" Padding="10" VerticalContentAlignment="Top" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource ModernTextBox}" Text="https://www.baidu.com"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="纠错等级" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="EccLevel" Grid.Column="1" Width="120" Height="34" VerticalContentAlignment="Center" Margin="0,0,12,0">
                        <ComboBoxItem Content="L - 低（约7%）"/>
                        <ComboBoxItem Content="M - 中（约15%）" IsSelected="True"/>
                        <ComboBoxItem Content="Q - 较高（约25%）"/>
                        <ComboBoxItem Content="H - 高（约30%）"/>
                    </ComboBox>

                    <Button x:Name="BtnGenerate" Grid.Column="2" Content="生成二维码" Click="BtnGenerate_Click"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                    <Button x:Name="BtnSave" Grid.Column="3" Content="保存PNG" Click="BtnSave_Click"
                            Style="{StaticResource BtnSecondary}" IsEnabled="False"/>
                </Grid>

                <TextBlock x:Name="StatusText" Text="输入内容后点击「生成二维码」" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- 预览区 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="White" Padding="8" CornerRadius="6" x:Name="ImageBorder">
                        <Image x:Name="QrImage" Width="320" Height="320" Stretch="Uniform"/>
                    </Border>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="BtnCopy" Content="复制图片" Click="BtnCopy_Click" Style="{StaticResource BtnSecondary}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="BtnCopyText" Content="复制内容" Click="BtnCopyText_Click" Style="{StaticResource BtnSecondary}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
