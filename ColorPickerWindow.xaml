<UserControl x:Class="Toolbox.ColorPickerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题（图标 + 工具名） -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="40" Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="屏幕取色" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="拾取屏幕上任意像素颜色（HEX / RGB）" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPick" Grid.Column="0" Content="取色" Click="BtnPick_Click" Style="{StaticResource PrimaryButton}" Padding="20,8" FontWeight="SemiBold"/>
                <TextBlock x:Name="Hint" Grid.Column="2" Text="点击「取色」后，在屏幕上点击任意位置即可取色（Esc 取消）" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="ColorSwatch" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,10,0" Height="180" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#FFFFFF">
                <Grid>
                    <Border x:Name="CheckerBg" CornerRadius="14" Background="Transparent"/>
                    <Border x:Name="SolidColorBg" CornerRadius="14" Background="#FFFFFF"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,12" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="HEX" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexBox" Grid.Column="0" Height="32" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="14"/>
                        <Button Grid.Column="1" Content="复制" Click="BtnCopyHex_Click" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="RGB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RgbBox" Grid.Column="0" Height="32" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" FontSize="14"/>
                        <Button Grid.Column="1" Content="复制" Click="BtnCopyRgb_Click" Style="{StaticResource BtnSecondary}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="10,14,0,0">
                <StackPanel>
                    <TextBlock Text="历史" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="32" Height="32" CornerRadius="6" Margin="0,0,6,6" Cursor="Hand"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        MouseLeftButtonUp="HistorySwatch_Click"
                                        Tag="{Binding}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
