<Window x:Class="Toolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="纳米工具箱"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{DynamicResource BackgroundBrush}"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（无缝，主题感知） -->
        <Border x:Name="TitleBar" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Background="{DynamicResource BackgroundBrush}"
                BorderThickness="0,0,0,1">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource Border}"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="36" Height="36" Background="{DynamicResource PrimaryBrush}" CornerRadius="9">
                        <Path Data="{StaticResource IconToolbox}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="White"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="纳米工具箱" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Toolbox" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧窗口控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnTheme" Style="{DynamicResource TitleBarButton}" Click="BtnTheme_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Image x:Name="ThemeIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                    <Button x:Name="BtnMin" Style="{DynamicResource TitleBarButton}" Click="BtnMin_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Rectangle Width="13" Height="1.5" Fill="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{DynamicResource TitleBarCloseButton}" Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource IconX}" Width="15" Height="15" Fill="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border x:Name="LeftNavBorder" Grid.Column="0" BorderThickness="0,0,1,0">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Border}"/>
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource BackgroundSecondary}"/>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="14,18,14,0">
                        <TextBlock Text="导航" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="10,0,0,10"/>
                        <Button x:Name="NavHome" Style="{DynamicResource SideNavItemActive}" Click="LeftNav_Click" Tag="HomePage">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}" VerticalAlignment="Center">
                                    <Image x:Name="NavHomeIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="主页" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBuiltIn" Style="{DynamicResource SideNavItem}" Click="LeftNav_Click" Tag="BuiltInPage">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}" VerticalAlignment="Center">
                                    <Image x:Name="NavBuiltInIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="内置工具" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavApp" Style="{DynamicResource SideNavItem}" Click="LeftNav_Click" Tag="AppPage">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}" VerticalAlignment="Center">
                                    <Image x:Name="NavAppIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="应用" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPackages" Style="{DynamicResource SideNavItem}" Click="LeftNav_Click" Tag="PackagesPage">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}" VerticalAlignment="Center">
                                    <Image x:Name="NavPackagesIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="安装包" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{DynamicResource SideNavItem}" Click="LeftNav_Click" Tag="SettingsPage">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}" VerticalAlignment="Center">
                                    <Image x:Name="NavSettingsIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="设置" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="14,12">
                        <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>
                        <Grid x:Name="PerfMonitorHost" Margin="0,0,0,10"/>
                        <TextBlock Text="纳米工具箱 v1.0.0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" x:Name="MainContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索框（工具内嵌时隐藏） -->
                <Border Grid.Row="0" Margin="28,24,28,16" x:Name="SearchBoxContainer">
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="44"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                                 GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
                            <Image x:Name="SearchIcon" Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="搜索工具或功能" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 三个页面容器 + 工具内嵌容器 -->
                <Grid Grid.Row="1" Margin="28,0,28,28">
                    <!-- 主页（系统总览） -->
                    <ContentControl x:Name="HomePage" Visibility="Visible" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <!-- 内置工具页（工具分类） -->
                    <ScrollViewer x:Name="BuiltInPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <!-- Hero 横幅 -->
                            <Border x:Name="HeroBanner" Margin="0,0,0,24" Height="124" CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Primary}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource PrimaryPressed}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="30,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                                        <TextBlock Text="欢迎使用 纳米工具箱" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="内置常用、系统、网络与办公工具，开箱即用。" FontSize="14" Foreground="#E8F0FE" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Width="92" Height="92" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border CornerRadius="22" Background="#FFFFFF" Opacity="0.12"/>
                                        <Image x:Name="BannerIcon" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 内置工具分类 -->
                            <StackPanel x:Name="BuiltInToolsPanel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 工具内嵌视图（点击工具时显示） -->
                    <ContentControl x:Name="ToolHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

                    <!-- APP 工具箱页 -->
                    <Grid x:Name="AppPage" Visibility="Collapsed" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部横向分类标签栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12" MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左箭头 -->
                            <Button x:Name="AppTabScrollLeft" Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0"
                                    Click="AppTabScrollLeft_Click" Visibility="Collapsed"
                                    Style="{DynamicResource BtnIcon}">
                                <Path Data="M3.6 5l2.4-2.4a.6.6 0 0 1 .8.8V7.4a.6.6 0 0 1-.8.8L3.6 5z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>

                            <!-- 标签横向滚动区 -->
                            <ScrollViewer x:Name="AppTabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" SizeChanged="AppTabScrollViewer_SizeChanged" MinHeight="40">
                                <StackPanel x:Name="AppTabPanel" Orientation="Horizontal"/>
                            </ScrollViewer>

                            <!-- 右箭头 -->
                            <Button x:Name="AppTabScrollRight" Grid.Column="2" Width="28" Height="28" Margin="8,0,0,0"
                                    Click="AppTabScrollRight_Click" Visibility="Collapsed"
                                    Style="{DynamicResource BtnIcon}">
                                <Path Data="M6.4 5L4 7.4a.6.6 0 0 1-.8-.8V3.4a.6.6 0 0 1 .8-.8L6.4 5z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>
                        </Grid>

                        <!-- 分隔线 -->
                        <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8,0,0"/>

                        <!-- 工具内容区 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,48,0,0">
                            <WrapPanel x:Name="AppToolsPanel" Margin="0,16,0,28"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 安装包页（与 APP 工具箱同构：分类标签 + 卡片网格） -->
                    <Grid x:Name="PackagesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 顶部横向分类标签栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12" MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PackagesTabScrollLeft" Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0"
                                    Click="PackagesTabScrollLeft_Click" Visibility="Collapsed"
                                    Style="{DynamicResource BtnIcon}">
                                <Path Data="M3.6 5l2.4-2.4a.6.6 0 0 1 .8.8V7.4a.6.6 0 0 1-.8.8L3.6 5z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>

                            <ScrollViewer x:Name="PackagesTabScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" SizeChanged="PackagesTabScrollViewer_SizeChanged" MinHeight="40">
                                <StackPanel x:Name="PackagesTabPanel" Orientation="Horizontal"/>
                            </ScrollViewer>

                            <Button x:Name="PackagesTabScrollRight" Grid.Column="2" Width="28" Height="28" Margin="8,0,0,0"
                                    Click="PackagesTabScrollRight_Click" Visibility="Collapsed"
                                    Style="{DynamicResource BtnIcon}">
                                <Path Data="M6.4 5L4 7.4a.6.6 0 0 1-.8-.8V3.4a.6.6 0 0 1 .8-.8L6.4 5z"
                                      Fill="{DynamicResource TextPrimaryBrush}" Stretch="Uniform" Width="10" Height="10"/>
                            </Button>
                        </Grid>

                        <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,8,0,0"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,48,0,0">
                            <WrapPanel x:Name="PackagesToolsPanel" Margin="0,16,0,28"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 设置页 -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                            <!-- 主题 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="主题" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                    <!-- 选择主题 -->
                                    <Grid Height="52" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource BackgroundHoverBrush}" Grid.Column="0">
                                            <Image x:Name="SettingsThemeIcon" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="主题配色" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="选择喜欢的配色，深浅由下方外观模式决定" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeSelector" Grid.Column="2" Width="150" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="ThemeSelector_SelectionChanged" Loaded="ThemeSelector_Loaded"/>
                                    </Grid>

                                    <!-- 外观模式（自动 / 深色 / 浅色） -->
                                    <Grid Height="52" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource BackgroundHoverBrush}" Grid.Column="0">
                                            <Image x:Name="SettingsDarkIcon" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="外观模式" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="自动跟随系统，或固定深色 / 浅色" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ModeSelector" Grid.Column="2" Width="180" Height="34" Style="{StaticResource ModernComboBox}" SelectionChanged="ModeSelector_SelectionChanged" Loaded="ModeSelector_Loaded"/>
                                    </Grid>

                                    <!-- 动画开关 -->
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource BackgroundHoverBrush}" Grid.Column="0">
                                            <Image x:Name="SettingsAnimationIcon" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="界面动画" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="关闭后页面切换和磁贴动画将停止" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="AnimationToggle" Grid.Column="2" Width="48" Height="26" Checked="AnimationToggle_Checked" Unchecked="AnimationToggle_Unchecked" Style="{DynamicResource ModernToggleSwitch}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 主题包 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="主题包" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <Grid Height="52" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="导入 zip 主题包" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="CurrentThemeNameText" Text="当前：内置深色" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnLoadZipTheme" Grid.Column="1" Content="选择 zip 文件" Click="BtnLoadZipTheme_Click" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="不了解 zip 主题包？点右侧生成一个示例" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Button x:Name="BtnCreateSampleZipTheme" Grid.Column="1" Content="生成示例主题包" Click="CreateSampleZipTheme_Click" Style="{StaticResource BtnSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 图标库 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="图标库" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="内置图标包（白/黑两套，共 1630 个）。点击图标可预览，并导出到 Icons 目录或复制 pack 路径，方便给工具 / 分类设置图标。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <!-- 白/黑切换 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button x:Name="IconSetWhite" Content="白色" Click="IconSetWhite_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Padding="14,6"/>
                                        <Button x:Name="IconSetBlack" Content="黑色" Click="IconSetBlack_Click" Style="{DynamicResource BtnSecondary}" Padding="14,6"/>
                                    </StackPanel>

                                    <!-- 分类标签 -->
                                    <WrapPanel x:Name="IconPackCategories" Orientation="Horizontal" Margin="0,0,0,12"/>

                                    <!-- 图标网格 -->
                                    <ScrollViewer x:Name="IconPackScroll" Height="320" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="BubbleScroll_PreviewMouseWheel">
                                        <WrapPanel x:Name="IconPackGrid" Orientation="Horizontal"/>
                                    </ScrollViewer>

                                    <!-- 预览 / 操作 -->
                                    <Border x:Name="IconPackPreview" Visibility="Collapsed" Margin="0,14,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="IconPackPreviewBox" Width="64" Height="64" CornerRadius="10" Background="#2D2D30" Grid.Column="0">
                                                <Image x:Name="IconPackPreviewImg" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="IconPackPreviewName" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="IconPackPreviewPath" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="IconPackExportBtn" Content="导出到 Icons" Click="IconPackExportBtn_Click" Style="{DynamicResource BtnSecondary}" Margin="0,0,8,0" Padding="12,6"/>
                                                <Button x:Name="IconPackCopyBtn" Content="复制路径" Click="IconPackCopyBtn_Click" Style="{DynamicResource BtnSecondary}" Padding="12,6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 开发者模式（DEVtool 彩蛋解锁后显示） -->
                            <Border x:Name="DevModePanel" Visibility="Collapsed" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="开发者模式" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="高级自定义设置。改完记得点对应区块里的「应用」按钮，所有更改会保存到 settings.txt。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <!-- 子区块 1：图标快捷设置 -->
                                    <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}">
                                        <StackPanel>
                                            <TextBlock Text="图标快捷设置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="先在上方「图标库」选中一个图标，然后选目标 → 点「应用图标」。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="DevIconTargetCombo" Grid.Column="0" Style="{StaticResource ModernComboBox}" Height="34"/>
                                                <Button Grid.Column="1" Content="应用图标" Click="DevIconApply_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,6"/>
                                            </Grid>

                                            <TextBlock x:Name="DevIconStatus" Text="尚未选中图标（在「图标库」点一下就选中）" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 子区块 2：文本标题编辑 -->
                                    <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}">
                                        <StackPanel>
                                            <TextBlock Text="文本标题编辑" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="格式：键=值（每行一个）。常用键：WindowTitle / NavHome / NavBuiltIn / NavApp / NavPackages / NavSettings" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                            <TextBox x:Name="DevTextEditor" Style="{StaticResource ModernTextBox}" Height="160"
                                                     AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="BubbleScroll_PreviewMouseWheel"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="应用文本" Click="DevTextApply_Click" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0"/>
                                                <Button Content="重置默认" Click="DevTextReset_Click" Style="{StaticResource BtnSecondary}" Padding="14,6" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="DevTextStatus" Text="" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 子区块 3：主题快速编辑 -->
                                    <Border Padding="14,10" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}">
                                        <StackPanel>
                                            <TextBlock Text="主题快速编辑" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="修改主色 / 背景 / 文字三档，6 位 HEX（如 #4285F4）。点「应用」立即生效并保存。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="主色" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBox x:Name="DevColorPrimary" Grid.Column="1" Style="{StaticResource ModernTextBox}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" TextChanged="DevColor_TextChanged"/>
                                                <Border x:Name="DevColorPrimaryPreview" Grid.Column="2" Height="32" CornerRadius="6" Background="#4285F4"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="背景" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBox x:Name="DevColorBackground" Grid.Column="1" Style="{StaticResource ModernTextBox}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" TextChanged="DevColor_TextChanged"/>
                                                <Border x:Name="DevColorBackgroundPreview" Grid.Column="2" Height="32" CornerRadius="6" Background="#121212"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="文字" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBox x:Name="DevColorText" Grid.Column="1" Style="{StaticResource ModernTextBox}" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" TextChanged="DevColor_TextChanged"/>
                                                <Border x:Name="DevColorTextPreview" Grid.Column="2" Height="32" CornerRadius="6" Background="#FFFFFF"/>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="应用并保存" Click="DevColorApply_Click" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0"/>
                                                <Button Content="恢复当前主题" Click="DevColorReset_Click" Style="{StaticResource BtnSecondary}" Padding="14,6"/>
                                                <TextBlock x:Name="DevColorStatus" Text="" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 关于 -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource BackgroundHoverBrush}" Grid.Column="0" MouseLeftButtonDown="AboutIcon_MouseLeftButtonDown" Cursor="Hand">
                                            <Image x:Name="AboutIcon" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="纳米工具箱" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="版本 1.0.0  ·  纳米工具箱团队" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 彩蛋：亚克力透明背景（CM666 解锁后显示） -->
                                    <Border x:Name="AcrylicEggPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource BackgroundHoverBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="亚克力透明背景" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="让窗口变成磨砂玻璃效果" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="AcrylicToggle" Grid.Column="1" Width="48" Height="26" Style="{DynamicResource ModernToggleSwitch}" Checked="AcrylicToggle_Checked" Unchecked="AcrylicToggle_Unchecked"/>
                                        </Grid>
                                    </Border>

                                    <!-- 彩蛋：千万别点（关于图标点 5 次后显示） -->
                                    <Border x:Name="NeverClickEggPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="#33EA4335">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="千万别点" FontSize="14" FontWeight="SemiBold" Foreground="#EA4335"/>
                                                <TextBlock Text="你已经被警告过了..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnNeverClick" Grid.Column="1" Content="点我" Click="BtnNeverClick_Click" Background="#EA4335" Foreground="White" Padding="14,6" Style="{StaticResource PrimaryButton}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
