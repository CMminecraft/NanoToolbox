<UserControl x:Class="Toolbox.CalculatorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="计算器" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

        <Border Grid.Row="1" HorizontalAlignment="Left" Width="400">
            <StackPanel>
                <!-- 显示屏 -->
                <Border Margin="0,0,0,14" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundCardBrush}">
                    <TextBox x:Name="Display"
                             FontSize="36" FontFamily="Consolas"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             HorizontalContentAlignment="Right"
                             Padding="14,22"
                             IsReadOnly="True"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             Text="0"/>
                </Border>

                <!-- 按钮区（UniformGrid 自动等分） -->
                <UniformGrid Rows="5" Columns="4" Width="400" Height="350">
                    <Button Content="C" FontSize="20" Click="BtnClear_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="±" FontSize="20" Click="BtnNegate_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="%" FontSize="20" Click="BtnPercent_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="÷" FontSize="20" Click="BtnDivide_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>

                    <Button Content="7" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="8" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="9" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="×" FontSize="20" Click="BtnMultiply_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>

                    <Button Content="4" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="5" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="6" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="-" FontSize="20" Click="BtnSubtract_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>

                    <Button Content="1" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="2" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="3" FontSize="20" Click="BtnNumber_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="+" FontSize="20" Click="BtnAdd_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>

                    <!-- 0 跨 2 列 -->
                    <Button Content="0" FontSize="20" Click="BtnZero_Click" Style="{StaticResource BtnSecondary}" Margin="2" Grid.ColumnSpan="2"/>
                    <Button Content="." FontSize="20" Click="BtnDot_Click" Style="{StaticResource BtnSecondary}" Margin="2"/>
                    <Button Content="=" FontSize="20" Click="BtnEquals_Click" Style="{StaticResource PrimaryButton}" Margin="2"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
