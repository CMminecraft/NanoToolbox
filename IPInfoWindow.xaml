<UserControl x:Class="Toolbox.IPInfoWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="获取网络信息" Click="BtnGetInfo_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="主机名" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="HostName" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="--" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="IPv4 地址" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="IPv4Addresses" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="--" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="IPv6 地址" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="IPv6Addresses" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="--" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DNS 服务器" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="DnsServers" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="--" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="网关" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="Gateways" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="--" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
