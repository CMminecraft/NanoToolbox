                            <Border x:Name="LeftBar" Width="3" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" Opacity="0" Margin="-12,2,0,2"/>
                            <ContentPresenter x:Name="CP" Margin="4,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </ContentPresenter.RenderTransform>
