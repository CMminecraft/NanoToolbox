<UserControl x:Class="Toolbox.DownloaderWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题（图标 + 工具名） -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="40" Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="多线程下载" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="Range 分段并行 · 自动续传 · 自定义请求头" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 输入区 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="16,14">
            <StackPanel>
                <TextBlock Text="下载地址 (URL)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="UrlInput" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                         Style="{StaticResource ModernTextBox}" Text="https://speed.hetzner.de/100MB.bin"
                         ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                         Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="线程数" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ThreadCount" Grid.Column="1" Width="90" Height="34" VerticalContentAlignment="Center" Margin="0,0,12,0">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="4" IsSelected="True"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="16"/>
                    </ComboBox>

                    <Button x:Name="BtnBrowse" Grid.Column="2" Content="保存位置" Click="BtnBrowse_Click"
                            Style="{StaticResource BtnSecondary}" Margin="0,0,12,0"/>
                    <Button x:Name="BtnStart" Grid.Column="3" Content="开始下载" Click="BtnStart_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标文件" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="PathInput" Grid.Column="1" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                             Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                    <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="打开文件夹" Click="BtnOpenFolder_Click"
                            Style="{StaticResource BtnSecondary}" Margin="12,0,0,0" Visibility="Collapsed"/>
                </Grid>

                <TextBlock Text="自定义请求头（可选，每行格式：Header: Value，# 开头为注释）"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="CustomHeadersBox" Height="60"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, monospace" FontSize="11"
                         VerticalContentAlignment="Top"
                         Padding="10,6"
                         Style="{StaticResource ModernTextBox}"
                         ToolTip="每行一个 HTTP 头，从浏览器开发者工具 Network 面板复制 Request Headers 粘贴进来即可。&#xa;示例：&#xa;Referer: https://example.com/page&#xa;Cookie: key=value" />
            </StackPanel>
        </Border>

        <!-- 进度区 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="16,14">
            <StackPanel>
                <Grid>
                    <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="100" Value="0"
                                 Style="{StaticResource ProgressBarModern}"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="进度" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="速度" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SpeedText" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0">
                        <TextBlock Text="已下载 / 总计" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SizeText" Text="0 / 0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="8,0">
                        <TextBlock Text="剩余时间" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="EtaText" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnPause" Content="暂停" Click="BtnPause_Click" Style="{StaticResource BtnSecondary}" IsEnabled="False" Margin="0,0,10,0"/>
                    <Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click" Style="{StaticResource BtnSecondary}" IsEnabled="False"/>
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 分段状态 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="16,14">
            <StackPanel>
                <TextBlock Text="分段状态" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="SegmentPanel" Orientation="Horizontal"/>
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Padding="14" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
