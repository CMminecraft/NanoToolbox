<UserControl x:Class="Toolbox.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 欢迎横幅 -->
        <Border x:Name="HeroBanner" Grid.Row="0" Height="160" CornerRadius="20" Margin="0,0,0,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource Primary}" Offset="0"/>
                    <GradientStop Color="{DynamicResource PrimaryPressed}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="640">
                    <TextBlock x:Name="WelcomeTitle" Text="欢迎使用 纳米工具箱" FontSize="30" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="WelcomeSub" Text="在这里快速进入所有工具和设置。" FontSize="14" Foreground="#E8F0FE" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="24" Background="#FFFFFF" Opacity="0.12"/>
                    <Image x:Name="HomeBannerIcon" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 滚动内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <!-- 性能概览（CPU/内存/磁盘） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="性能概览" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BackgroundHoverBrush}" CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <TextBlock x:Name="HomeCpuLabel" Text="CPU 占用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="HomeCpuValue" Text="--" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="HomeCpuBar" Height="6" Maximum="100" Value="0" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderLightBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource BackgroundHoverBrush}" CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <TextBlock x:Name="HomeMemLabel" Text="内存占用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="HomeMemValue" Text="--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="HomeMemBar" Height="6" Maximum="100" Value="0" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderLightBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource BackgroundHoverBrush}" CornerRadius="12" Padding="16,14">
                                <StackPanel>
                                    <TextBlock x:Name="HomeDiskLabel" Text="磁盘占用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="HomeDiskValue" Text="--" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="HomeDiskBar" Height="6" Maximum="100" Value="0" Margin="0,10,0,0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderLightBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 硬件信息（全面） -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="硬件信息" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <!-- 第 1 行 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="操作系统" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OsName" Grid.Row="0" Grid.Column="1" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="系统类型" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OsArch" Grid.Row="0" Grid.Column="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- 第 2 行 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="处理器" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuName" Grid.Row="1" Grid.Column="1" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="主频" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuFreq" Grid.Row="1" Grid.Column="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- 第 3 行 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="核心 / 线程" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CoreCount" Grid.Row="2" Grid.Column="1" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="架构" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuArch" Grid.Row="2" Grid.Column="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- 第 4 行 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="总内存" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalMemory" Grid.Row="3" Grid.Column="1" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="可用内存" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AvailMemory" Grid.Row="3" Grid.Column="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- 第 5 行 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="显卡" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GpuName" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <!-- 第 6 行 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="主板" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Motherboard" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <!-- 第 7 行 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="屏幕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScreenInfo" Grid.Row="6" Grid.Column="1" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="DPI 缩放" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DpiScale" Grid.Row="6" Grid.Column="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <!-- 第 8 行 -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="网络适配器" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetAdapter" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <!-- 第 9 行 -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="机器 / 用户" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MachineUser" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 当前配置 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="当前配置" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="主题配色" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CfgColor" Grid.Row="0" Grid.Column="1" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="外观模式" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CfgMode" Grid.Row="0" Grid.Column="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="主题包" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CfgTheme" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="--" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
