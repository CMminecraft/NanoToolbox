<UserControl x:Class="Toolbox.NotepadWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnNew" Click="BtnNew_Click" ToolTip="新建" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Width="16" Height="16"/>
                        <TextBlock Text="新建" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnOpen" Click="BtnOpen_Click" ToolTip="打开" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Width="16" Height="16"/>
                        <TextBlock Text="打开" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSave" Click="BtnSave_Click" ToolTip="保存" Margin="0,0,16,0" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSave}" Width="16" Height="16"/>
                        <TextBlock Text="保存" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnUndo" Click="BtnUndo_Click" ToolTip="撤销" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                        <TextBlock Text="撤销" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRedo" Click="BtnRedo_Click" ToolTip="重做" Margin="0,0,16,0" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                        <TextBlock Text="重做" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSelectAll" Click="BtnSelectAll_Click" ToolTip="全选" Style="{StaticResource BtnSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconExpand}" Width="16" Height="16"/>
                        <TextBlock Text="全选" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <TextBox x:Name="TextEditor"
                     AcceptsReturn="True" AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="14" Padding="14"
                     BorderThickness="0" Background="Transparent"/>
        </Border>
    </Grid>
</UserControl>
